<product-info
    id="MainProduct-{{ section.id }}"
    class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}"
    data-section="{{ section.id }}"
    data-product-id="{{ product.id }}"
    data-update-url="true"
    data-url="{{ product.url }}"
    {% if section.settings.image_zoom == 'hover' %}
      data-zoom-on-hover
    {% endif %}
  >
    {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
    {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
    {{ 'component-price.css' | asset_url | stylesheet_tag }}
    {{ 'component-slider.css' | asset_url | stylesheet_tag }}
    {{ 'component-rating.css' | asset_url | stylesheet_tag }}
    {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

    {% unless product.has_only_default_variant %}
      {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
      {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
      {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
    {% endunless %}
    {%- if product.quantity_price_breaks_configured? -%}
      {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
    {%- endif -%}

    {%- style -%}
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
        padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
      }

      @media screen and (min-width: 750px) {
        .section-{{ section.id }}-padding {
          padding-top: {{ section.settings.padding_top }}px;
          padding-bottom: {{ section.settings.padding_bottom }}px;
        }
      }
    {%- endstyle -%}

    <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
    {%- if product.quantity_price_breaks_configured? -%}
      <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
      <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {% if section.settings.image_zoom == 'hover' %}
      <script id="EnableZoomOnHover-main" src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
    {% endif %}
    {%- if request.design_mode -%}
      <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
    {%- if first_3d_model -%}
      {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
      <link
        id="ModelViewerStyle"
        rel="stylesheet"
        href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
        media="print"
        onload="this.media='all'"
      >
      <link
        id="ModelViewerOverride"
        rel="stylesheet"
        href="{{ 'component-model-viewer-ui.css' | asset_url }}"
        media="print"
        onload="this.media='all'"
      >
    {%- endif -%}


    
  <div class="product-variant-gallery">
  <!-- Product Info -->
  <div class="product-info">
    <h2 class="product-title">{{ product.title }}</h2>
    <h3 class="variant-title">Variante: {{ product.variants.first.title }}</h3>
    <button class="buy-now-btn pulse">
      Jetzt für {{ product.price | money }} kaufen
      {%- if product.compare_at_price -%}
        <span class="compare-price">statt {{ product.compare_at_price | money }}</span>
      {%- endif -%}
    </button>
  </div>
   <!-- Collapsible Product Description -->
  <div class="product-description" style="display: flex; flex-direction: column; align-items: center;">
    <button class="toggle-description-btn" style="margin: 0 auto;">Produktbeschreibung anzeigen</button>
    <div class="description-content hidden">
      <p>{{ product.description }}</p>
    </div>
  </div>

  <!-- Product Images -->
  <div class="product-images">
    <div class="main-variant-image">
      {%- if product.featured_image -%}
        <img src="{{ product.featured_image | img_url: '600x600' }}" 
             alt="{{ product.title }}" 
             class="variant-image-large fade-in">
      {%- endif -%}
    </div>
    {%- if product.variants.size > 0 -%}
      <div class="variant-thumbnails">
        {%- for variant in product.variants -%}
          {%- if variant.featured_image -%}
            <div class="variant-thumbnail" 
                 data-variant-id="{{ variant.id }}"
                 data-variant-price="{{ variant.price | money }}"
                 data-variant-image="{{ variant.featured_image | img_url: '600x600' }}"
                 data-variant-title="{{ variant.title }}">
              <img src="{{ variant.featured_image | img_url: '150x150' }}" 
                   alt="{{ variant.title }}" 
                   class="variant-image-small">
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

 
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const thumbnails = document.querySelectorAll('.variant-thumbnail');
  const mainImage = document.querySelector('.variant-image-large');
  const priceElement = document.querySelector('.product-price');
  const variantTitleElement = document.querySelector('.variant-title');
  const buyNowButton = document.querySelector('.buy-now-btn');
  const toggleDescriptionButton = document.querySelector('.toggle-description-btn');
  const descriptionContent = document.querySelector('.description-content');

  // Function to set the default variant
  function setDefaultVariant() {
    const defaultThumbnail = thumbnails[0];
    if (defaultThumbnail) {
      const variantImage = defaultThumbnail.getAttribute('data-variant-image');
      const variantPrice = defaultThumbnail.getAttribute('data-variant-price');
      const variantComparePrice = defaultThumbnail.getAttribute('data-variant-compare-price');
      const variantTitle = defaultThumbnail.getAttribute('data-variant-title');
      const variantId = defaultThumbnail.getAttribute('data-variant-id');

      // Update main image
      if (mainImage && variantImage) {
        mainImage.src = variantImage;
        mainImage.alt = variantTitle;
      }

      // Update price
      if (priceElement && variantPrice) {
        priceElement.textContent = variantPrice;
      }

      // Update variant title
      if (variantTitleElement && variantTitle) {
        variantTitleElement.textContent = "Variante: " + variantTitle;
      }

      // Update "Jetzt kaufen" button
      if (buyNowButton) {
        buyNowButton.innerHTML = `Jetzt für ${variantPrice} kaufen`;
        if (variantComparePrice) {
          buyNowButton.innerHTML += ` <span class="compare-price">statt ${variantComparePrice}</span>`;
        }
        buyNowButton.setAttribute('data-variant-id', variantId); // Store variant ID in button
      }

      // Set active thumbnail
      defaultThumbnail.classList.add('active');
    }
  }

  // Initialize default variant
  setDefaultVariant();

  // Variant selection logic
  thumbnails.forEach(function(thumbnail) {
    thumbnail.addEventListener('click', function() {
      const variantImage = this.getAttribute('data-variant-image');
      const variantPrice = this.getAttribute('data-variant-price');
      const variantComparePrice = this.getAttribute('data-variant-compare-price');
      const variantTitle = this.getAttribute('data-variant-title');
      const variantId = this.getAttribute('data-variant-id');

      // Update main image
      if (mainImage && variantImage) {
        mainImage.style.transform = 'scale(0.9)';
        mainImage.style.opacity = '0.7';
        setTimeout(function() {
          mainImage.src = variantImage;
          mainImage.alt = variantTitle;
          mainImage.style.transform = 'scale(1)';
          mainImage.style.opacity = '1';
        }, 150);
      }

      // Update price
      if (priceElement && variantPrice) {
        priceElement.classList.remove('price-animate');
        void priceElement.offsetWidth; // trigger reflow
        priceElement.textContent = variantPrice;
        priceElement.classList.add('price-animate');
      }

      // Update variant title
      if (variantTitleElement && variantTitle) {
        variantTitleElement.textContent = "Variante: " + variantTitle;
      }

      // Update "Jetzt kaufen" button
      if (buyNowButton) {
        buyNowButton.innerHTML = `Jetzt für ${variantPrice} kaufen`;
        if (variantComparePrice) {
          buyNowButton.innerHTML += ` <span class="compare-price">statt ${variantComparePrice}</span>`;
        } else {
          buyNowButton.innerHTML = `Jetzt für ${variantPrice} kaufen`; // Remove comparison price if not available
        }
        buyNowButton.setAttribute('data-variant-id', variantId); // Store variant ID in button
      }

      // Update active thumbnail
      thumbnails.forEach(function(thumb) {
        thumb.classList.remove('active');
      });
      this.classList.add('active');
    });
  });

  // Add selected variant to cart
  buyNowButton.addEventListener('click', function() {
    const selectedVariantId = buyNowButton.getAttribute('data-variant-id');
    if (selectedVariantId) {
      const form = document.createElement('form');
      form.method = 'post';
      form.action = '/cart/add';
      const input = document.createElement('input');
      input.type = 'hidden';
      input.name = 'id';
      input.value = selectedVariantId;
      form.appendChild(input);
      document.body.appendChild(form);
      form.submit();
    }
  });

  // Toggle product description
  toggleDescriptionButton.addEventListener('click', function() {
    descriptionContent.classList.toggle('hidden');
    toggleDescriptionButton.textContent = descriptionContent.classList.contains('hidden') 
      ? 'Produktbeschreibung anzeigen' 
      : 'Produktbeschreibung ausblenden';
  });
});
</script>

<style>
.product-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20px;
}

.product-title {
  font-size: 2rem;
  font-weight: bold;
  margin-bottom: 5px;
}

.variant-title {
  font-size: 1.5rem;
  font-weight: normal;
  color: #555;
  margin-bottom: 10px;
}

.buy-now-btn {
  background: linear-gradient(135deg, #FF4500, #FF6347);
  color: #FFF;
  font-size: 1.2rem;
  padding: 12px 24px;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  margin-top: 10px;
  position: relative;
}

.buy-now-btn:hover {
  background: linear-gradient(135deg, #FF6347, #FF4500);
  transform: scale(1.05);
}

.compare-price {
  font-size: 0.9rem;
  color: #FFD700;
  font-weight: bold;
  margin-left: 8px;
  text-shadow: 0 1px 2px rgba(0,0,0,0.2);
}

.product-images {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.main-variant-image {
  width: 100%;
  max-width: 600px;
  height: 400px; /* Fixed height to prevent layout shifts */
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}

.variant-image-large {
  max-height: 100%;
  max-width: 100%;
  object-fit: contain;
  border-radius: 12px;
  box-shadow: 0 4px 24px rgba(51,51,51,0.08);
  cursor: zoom-in;
  transition: transform 0.3s ease, box-shadow 0.3s ease, opacity 0.3s ease;
}

.variant-image-large:hover {
  transform: scale(1.05);
  box-shadow: 0 8px 32px rgba(51,51,51,0.15);
}

.variant-thumbnails {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 20px;
}

.variant-thumbnail img {
  width: 80px;
  height: 80px;
  object-fit: cover;
  border-radius: 6px;
  border: 2px solid transparent;
  transition: border-color 0.3s, box-shadow 0.3s;
}

.variant-thumbnail img:hover {
  border-color: #A0A0A0;
  cursor: pointer;
  box-shadow: 0 2px 8px rgba(51,51,51,0.10);
}

.variant-thumbnail.active img {
  border-color: #A0A0A0;
  box-shadow: 0 0 10px rgba(51,51,51,0.18);
}
</style>
    
    
    

  </product-info>

